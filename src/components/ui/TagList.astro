---
import { TagList as TagListComponent } from './tag-list';
export interface Props {
  tags: string[];
  variant?: 'default' | 'secondary' | 'outline' | 'ghost';
  size?: 'sm' | 'md' | 'lg';
  linkToTags?: boolean;
}
const { tags, variant = 'outline', size = 'sm', linkToTags = true } = Astro.props;
---
{tags && tags.length > 0 && (
  <TagListComponent 
    tags={tags} 
    variant={variant}
    size={size}
    linkToTags={linkToTags}
    client:only='react'
  />
)}