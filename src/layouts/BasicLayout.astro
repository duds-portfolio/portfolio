---
import BaseHead from "@/components/BaseHead.astro";
import { Navbar } from "@/components/sections/navbar";
import { Footer } from "@/components/sections/footer";

const { title, description } = Astro.props;
---

<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
  </head>
  <body class={`h-screen antialiased`}>
    <a
      href="#main-content"
      className="absolute left-[-9999px] top-4 z-50 rounded bg-primary px-4 py-2 text-white transition-all focus:left-4 focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2"
    >
      Skip to main content
    </a>
    <Navbar client:only='react' />
    <main id="main-content">
      <section class="mx-auto max-w-2xl px-4 py-16 md:py-28 lg:py-32">
        <article class="prose prose-lg dark:prose-invert">
          <slot />
        </article>
      </section>
    </main>
    <Footer />
  </body>
</html>
